{
  "name": "@kakomimasu/client-js",
  "version": "1.0.0-alpha.1",
  "exports": "./src/index.ts",
  "tasks": {
    "install": "deno install --allow-scripts",
    "generate": "openapi-generator-cli generate && deno fmt && deno lint --fix"
  },
  "lint": {
    "rules": {
      "exclude": ["no-unused-vars"]
    }
  },
  "publish": {
    "exclude": [
      "!src",
      ".vscode",
      ".github",
      "template",
      "openapitools.json"
    ]
  },
  "lock": false,
  "nodeModulesDir": "auto",
  "imports": {
    "@kakomimasu/client-js": "./src/index.ts",
    "@openapitools/openapi-generator-cli": "npm:@openapitools/openapi-generator-cli@^2.20.2",
    "@std/async": "jsr:@std/async@^1.0.13"
  }
}
